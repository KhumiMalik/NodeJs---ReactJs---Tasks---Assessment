# Test-only configuration (no real secrets). Loaded by vitest.config.ts.
# The database name MUST end with "_test"; the test setup refuses to run otherwise.
NODE_ENV=test
PORT=3001
DATABASE_URL="mysql://root:@127.0.0.1:3306/task_management_test"
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=test-only-session-secret-not-used-anywhere-else
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=1
TRUST_PROXY=false
BCRYPT_ROUNDS=4
