NODE_ENV=development
PORT=3000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@127.0.0.1:3306/task_management"

# Comma-separated list of allowed frontend origins (CORS with credentials).
FRONTEND_ORIGIN=http://localhost:5173

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# true when served over HTTPS (required in production).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=24
# true when running behind a reverse proxy / load balancer that terminates TLS.
TRUST_PROXY=false

BCRYPT_ROUNDS=12
