# Base URL the browser uses for API calls. The default "/api" goes through the
# Vite dev-server proxy (same origin, no CORS). Set a full URL such as
# http://localhost:3000/api only if you want the browser to call Express directly;
# then FRONTEND_ORIGIN in backend/.env must include this app's origin.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api requests (development only).
VITE_API_PROXY_TARGET=http://localhost:3000
